PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080
API_URL=http://localhost:5000

MONGODB_URI=mongodb://127.0.0.1:27017/lms

JWT_SECRET=skillbridge_lms_jwt_secret_change_in_production_2026
